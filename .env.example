# =============================================
# 项目敏感配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，请勿提交真实值！
# =============================================

# 数据库（Docker Compose 中 MySQL 的 root 密码，同时注入后端数据源）
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT 签名密钥（生产环境务必更换为足够长的随机串）
JWT_SECRET=change-me-to-a-long-random-string

# AI 大模型（OpenAI 兼容接口，默认为 Kimi / Moonshot）
AI_BASE_URL=https://api.moonshot.cn/v1
AI_API_KEY=sk-your-api-key
AI_MODEL=kimi-k2.6
